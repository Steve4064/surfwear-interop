# Copier en .env et changer les secrets (valeurs par défaut utilisées sinon).
# GATEWAY_PORT et ZITADEL_PORT sont enregistrés dans ZITADEL au premier démarrage :
# les fixer avant, ou repartir de zéro (docker compose down -v) après les avoir changés.
GATEWAY_PORT=8080
ZITADEL_PORT=8081

# Identité
AUTH_PROVIDER=zitadel
AUTH_SECRET=change-me-in-env-file
# 32 caractères exactement, non modifiable après l'initialisation de ZITADEL
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
LOGIN_SESSION_COOKIE_SECRET=SessionCookieSecretNeedsAtLeast32Chars
ZITADEL_ADMIN_PASSWORD=Password1!
STAFF_EMAIL=equipe@surfwear.example
STAFF_PASSWORD=Surfwear2026!
# Clé technique de l'équipe Surfwear pour les scripts (vide = désactivée)
STAFF_API_KEY=

# Commandes
HOLD_MINUTES=15

# Infrastructure
POSTGRES_PASSWORD=surfwear
RABBITMQ_USER=surfwear
RABBITMQ_PASSWORD=surfwear
WEBHOOK_SECRET=change-me
LOG_LEVEL=INFO
