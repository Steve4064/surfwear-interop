# Copier en .env pour personnaliser (valeurs par défaut utilisées sinon)
GATEWAY_PORT=8080
POSTGRES_PASSWORD=surfwear
RABBITMQ_USER=surfwear
RABBITMQ_PASSWORD=surfwear
WEBHOOK_SECRET=change-me
LOG_LEVEL=INFO
# Secret de signature des sessions (à changer : une longue chaîne aléatoire)
AUTH_SECRET=change-me-in-env-file
# Durée de la pré-réservation avant expiration, en minutes
HOLD_MINUTES=15
